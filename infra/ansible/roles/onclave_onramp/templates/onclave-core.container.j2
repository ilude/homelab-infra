[Unit]
Description=Onclave Core
PartOf=onclave-onramp.target
Requires=onclave-rabbitmq.service onclave-postgres.service onclave-ollama.service onclave-searxng.service onclave-docling.service
After=onclave-rabbitmq.service onclave-postgres.service onclave-ollama.service onclave-searxng.service onclave-docling.service
RequiresMountsFor=/srv/podman/{{ onramp_host_deploy_user }} {{ onramp_host_deploy_dir }}
RequiresMountsFor={{ onclave_onramp_base_dir }}/data/onclave {{ onclave_onramp_base_dir }}/authorized_keys

[Container]
ContainerName=onclave-core
Image={{ onclave_core_image_repository }}:{{ onclave_core_image_tag }}@{{ onclave_core_image_digest }}
Pull=missing
Network=onclave.network
NetworkAlias=onclave-core
EnvironmentFile={{ onclave_onramp_base_dir }}/env/core.env
PublishPort=127.0.0.1:{{ onclave_onramp_core_port }}:8000
AddHost={{ onclave_onramp_s3_hostname }}:host-gateway
Volume={{ onclave_onramp_base_dir }}/data/onclave:/data:Z,U
Volume={{ onclave_onramp_base_dir }}/authorized_keys:/keys/authorized_keys:ro,Z
HealthCmd=node -e 'fetch("http://127.0.0.1:8000/health").then(response => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1))'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=20s
HealthOnFailure=kill
Notify=healthy
Label=io.homelab.onclave.service=onclave-core

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=120
