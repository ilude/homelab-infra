---
x-podman:
  in_pod: false
services:
  gateway:
    image: "{{ web_fetch_gateway_image }}"
    pull_policy: never
    container_name: web-fetch-gateway
    restart: unless-stopped
    env_file: [./gateway.env]
    ports:
      - "127.0.0.1:{{ web_fetch_host_port }}:8080"
    volumes:
      - ./data:/state:Z,U
    mem_limit: 768m
    cpus: 1
    cap_drop: [ALL]
    security_opt: [no-new-privileges]
  browser:
    image: "{{ web_fetch_browser_image }}"
    pull_policy: never
    container_name: web-fetch-browser
    restart: unless-stopped
    # These are different network namespaces. Only this new browser container
    # installs its own egress rules and then removes NET_ADMIN from its bounding set.
    cap_add: [NET_ADMIN]
    dns: [none]
    volumes:
      - ./public-resolv.conf:/etc/resolv.conf:ro
    mem_limit: 2g
    cpus: 2
    pids_limit: 512
    shm_size: 512m
    environment:
      BROWSER_POOL_SIZE: "1"
      BROWSER_HEADFUL_POOL_SIZE: "0"
      BROWSER_ACQUIRE_TIMEOUT_MS: "1000"
      BROWSER_RECYCLE_AFTER_CONTEXTS: "0"
      BROWSER_STALL_TIMEOUT_MS: "1000"
      BROWSER_CLOSE_TIMEOUT_MS: "1000"
      BROWSER_LAUNCH_TIMEOUT_MS: "30000"
      REDIS_URL: ""
      REDIS_RETRY_DELAY_MS: "0"
      MITM_ENABLED: "false"
      MCP_ENABLED: "false"
