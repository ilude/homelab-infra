---
use_default_settings: true

server:
  secret_key: "{{ searxng_secret_key }}"
  bind_address: "0.0.0.0"
  port: 8080
{% if searxng_onramp_enable_public_url | bool %}
  base_url: "{{ searxng_public_url }}"
{% endif %}

ui:
  static_use_hash: true
  query_in_title: false

general:
  instance_name: "{{ searxng_onramp_instance_name }}"

search:
  safe_search: 1
  autocomplete: ""
  formats:
    - html
    - json

outgoing:
  request_timeout: 5.0
  max_request_timeout: 8.0

# Google and Brave are the general-search defaults. Disable, rather than remove,
# the other upstream general defaults so explicit engine selection still works.
engines:
  - name: google
    disabled: false
  - name: brave
    disabled: false
  - name: startpage
    disabled: true
  - name: google cse
    disabled: true
  - name: duckduckgo
    disabled: true
  - name: wikipedia
    disabled: true
  - name: wikidata
    disabled: true
  - name: currency
    disabled: true
  - name: lingva
    disabled: true
  - name: dictzone
    disabled: true
  - name: mymemory translated
    disabled: true
