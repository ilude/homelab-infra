[Unit]
Description=FreeLLMAPI onramp Podman workload
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/podman/{{ onramp_host_deploy_user }} {{ onramp_host_deploy_dir }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ freellmapi_onramp_base_dir }}
ExecStart={{ freellmapi_onramp_compose_provider_command }} -f {{ freellmapi_onramp_base_dir }}/docker-compose.yml up -d
ExecStop={{ freellmapi_onramp_compose_provider_command }} -f {{ freellmapi_onramp_base_dir }}/docker-compose.yml down
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=default.target
